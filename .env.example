# Copy to .env and fill in. Every value here is validated at startup;
# the process refuses to run with placeholders instead of secrets.

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Format: 123456789:AA...
BOT_TOKEN=
# Your numeric Telegram user id (from @userinfobot). Admin commands only.
ADMIN_USER_ID=
# Channel/group id where /feedback is delivered (e.g. -1001234567890).
FEEDBACK_CHANNEL_ID=

# --- Gmail ------------------------------------------------------------------
# The mailbox that receives every alias. IMAP must be enabled and 2FA + an
# App Password is required (a normal account password will not work).
GMAIL_EMAIL=you@gmail.com
# 16 characters from https://myaccount.google.com/apppasswords
# Paste it exactly as Google shows it -- spaces are stripped automatically:
#   GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=

# Optional: the plus-alias root/domain, if it differs from GMAIL_EMAIL.
# ALIAS_ROOT=you
# ALIAS_DOMAIN=gmail.com
# IMAP_HOST=imap.gmail.com
# Folder to poll. Change to [Gmail]/All Mail if a Gmail filter archives alias
# mail out of the inbox (see docs/GMAIL_SETUP.md).
# IMAP_MAILBOX=INBOX

# --- Storage ----------------------------------------------------------------
# Relative paths resolve against the project root (not the current directory).
# DB_PATH=data/bot.db
# LOG_PATH=data/bot.log
# LOG_LEVEL=INFO

# --- Behaviour --------------------------------------------------------------
# How long a received message stays readable. 3600 = 1 hour.
MESSAGE_TTL_SECONDS=3600
# Seconds between IMAP polls.
POLL_INTERVAL_SECONDS=10
# On a cold start, how far back to look for mail that arrived while offline.
INITIAL_LOOKBACK_DAYS=1
# Per-user alias cap and creation rate limit.
MAX_ALIASES_PER_USER=25
GENERATE_PER_HOUR=20

# --- Branding ---------------------------------------------------------------
# Shown in the welcome screen; defaults to a Unicode styled font. Plain text
# works here too if you'd rather not rely on those glyphs being available.
# BOT_BRAND_NAME=𝑻𝒆𝒎𝒑 𝑮𝒎𝒂𝒊𝒍 𝑩𝒐𝒕
# Appended as "Bot by: <value>" to every message the bot sends.
# BOT_CREDIT=𝙋𝙤𝙧𝙞𝙤𝙩_𝙠𝙚
# Image attached to /start and OTP alerts. Relative paths resolve against the
# project root; use "none" to disable.
# BOT_PHOTO_PATH=gmailbot/assets/tempgmail.jpg
# SEND_BRAND_PHOTO=true

# --- Force-join guard -------------------------------------------------------
# Require users to join your channel(s) before the bot responds. Manage the list
# at runtime with /addchannel and /delchannel; REQUIRED_CHANNELS only seeds it.
# Add the bot as an ADMIN in the channel, otherwise membership checks fail open.
FORCE_JOIN=true
# Comma-separated. Use @username for public channels or the -100... id for
# private ones. The @ is optional here (it is added automatically), but Telegram
# cannot resolve a bare handle, so do not drop it for numeric ids.
# REQUIRED_CHANNELS=@nativecodes,-1001234567890
# MEMBERSHIP_CACHE_SECONDS=300

# --- Optional AI (OpenRouter) -----------------------------------------------
# OPENROUTER_API_KEY=
# Learn click-wrapper patterns from ambiguous mail. Only REDACTED URL
# descriptions are sent (host, path, parameter names -- no tokens), the answer is
# used once to store a host pattern, and every later mail is filtered offline.
# Manage what was learned with /trackers.
# USE_AI_LINK_FALLBACK=false
# LINK_JUDGE_MODEL=openai/gpt-4o-mini
#
# Last-resort OTP extraction. WARNING: unlike the link judge this sends up to
# 4000 characters of the raw email body -- including the code -- to OpenRouter.
# Leave it off unless you accept that.
# USE_AI_OTP_FALLBACK=false

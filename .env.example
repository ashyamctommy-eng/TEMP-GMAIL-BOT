# Copy to .env and fill in. Every value here is validated at startup;
# the process refuses to run with placeholders instead of secrets.

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Format: 123456789:AA...
BOT_TOKEN=
# Your numeric Telegram user id (from @userinfobot). Admin commands only.
ADMIN_USER_ID=
# Channel/group id where /feedback is delivered (e.g. -1001234567890).
FEEDBACK_CHANNEL_ID=

# --- Gmail ------------------------------------------------------------------
# The mailbox that receives every alias. IMAP must be enabled and 2FA + an
# App Password is required (a normal account password will not work).
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=

# Optional: the plus-alias root/domain, if it differs from GMAIL_EMAIL.
# ALIAS_ROOT=you
# ALIAS_DOMAIN=gmail.com
# IMAP_HOST=imap.gmail.com

# --- Storage ----------------------------------------------------------------
# Relative paths resolve against the project root (not the current directory).
# DB_PATH=data/bot.db
# LOG_PATH=data/bot.log
# LOG_LEVEL=INFO

# --- Behaviour --------------------------------------------------------------
# How long a received message stays readable. 3600 = 1 hour.
MESSAGE_TTL_SECONDS=3600
# Seconds between IMAP polls.
POLL_INTERVAL_SECONDS=10
# On a cold start, how far back to look for mail that arrived while offline.
INITIAL_LOOKBACK_DAYS=1
# Per-user alias cap and creation rate limit.
MAX_ALIASES_PER_USER=25
GENERATE_PER_HOUR=20

# --- Branding ---------------------------------------------------------------
# Shown in the welcome screen; defaults to a Unicode styled font. Plain text
# works here too if you'd rather not rely on those glyphs being available.
# BOT_BRAND_NAME=𝑻𝒆𝒎𝒑 𝑮𝒎𝒂𝒊𝒍 𝑩𝒐𝒕
# Appended as "Bot by: <value>" to every message the bot sends.
# BOT_CREDIT=𝙋𝙤𝙧𝙞𝙤𝙩_𝙠𝙚
# Image attached to /start and OTP alerts. Relative paths resolve against the
# project root; use "none" to disable.
# BOT_PHOTO_PATH=gmailbot/assets/tempgmail.jpg
# SEND_BRAND_PHOTO=true

# --- Optional AI OTP fallback (OpenRouter) ----------------------------------
# OPENROUTER_API_KEY=
# USE_AI_OTP_FALLBACK=false
